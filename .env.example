# Optional canonical override. On Vercel the site also understands VERCEL_PROJECT_PRODUCTION_URL/VERCEL_URL.
# Use the production https://*.vercel.app URL with no trailing slash if you set this explicitly.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Optional live view for /collatz (server-side only; see docs/frontier-live-status.md).
# Leave unset to show "Working offline".
# FRONTIER_LIVE_STATUS_URL=https://status.example/frontier-live.json
# FRONTIER_LIVE_STATUS_TOKEN=
